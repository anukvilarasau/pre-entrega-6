# Copiá este archivo como .env y completá tus claves reales.
# El archivo .env está en .gitignore: NUNCA se sube a GitHub.
# Sin claves podés correr todo en modo mock: python main.py --mock

# Anthropic: https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
# Modelo de Claude que usan los agentes (uno barato alcanza)
ANTHROPIC_MODEL=claude-haiku-5-5

# Tavily (búsqueda web para agentes): https://app.tavily.com -> API Keys
# El plan gratis trae 1.000 búsquedas por mes.
TAVILY_API_KEY=

# 1 = modo mock (LLM con respuestas prefijadas + Tavily simulado)
MODO_MOCK=0
